{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm -r typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm -r test)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter @english-quest/shared build)",
      "Bash(pnpm --filter @english-quest/api openapi:generate)",
      "Bash(pnpm tokens:build)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(curl -s http://localhost:*)"
    ]
  }
}
