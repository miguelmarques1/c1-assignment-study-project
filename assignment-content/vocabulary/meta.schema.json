{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `pnpm content:schema` from @english-quest/shared and the error taxonomy. Do not edit by hand.",
  "title": "English Quest vocabulary item (meta.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Display title"
    },
    "cefr_level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Free topic label, e.g. climate policy"
    },
    "accent": {
      "not": {}
    },
    "skills": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "listening",
          "reading",
          "vocabulary",
          "grammar"
        ]
      },
      "uniqueItems": true
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Attribution for the original material"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "questions": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "const": "multiple_choice"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "options": {
                "minItems": 4,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "description": "Shown after the activity is submitted, whatever the answer was"
              }
            },
            "required": [
              "format",
              "prompt",
              "options",
              "answer",
              "explanation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "const": "fill_blank"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "answer": {
                "minItems": 1,
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "uniqueItems": true
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "description": "Shown after the activity is submitted, whatever the answer was"
              }
            },
            "required": [
              "format",
              "prompt",
              "answer",
              "explanation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "const": "ordering"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "segments": {
                "minItems": 3,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "uniqueItems": true
              },
              "answer": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "description": "Shown after the activity is submitted, whatever the answer was"
              }
            },
            "required": [
              "format",
              "prompt",
              "segments",
              "answer",
              "explanation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "const": "matching"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "left": {
                "minItems": 3,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "uniqueItems": true
              },
              "right": {
                "minItems": 3,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "uniqueItems": true
              },
              "answer": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "description": "Shown after the activity is submitted, whatever the answer was"
              }
            },
            "required": [
              "format",
              "prompt",
              "left",
              "right",
              "answer",
              "explanation"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "target_tags": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "enum": [
          "discourse:clarification",
          "discourse:cohesion",
          "discourse:connector",
          "discourse:hedging",
          "discourse:politeness",
          "discourse:turn-taking",
          "grammar:article-definite",
          "grammar:article-indefinite",
          "grammar:comparison",
          "grammar:conditional-2",
          "grammar:conditional-3",
          "grammar:conditional-mixed",
          "grammar:countable-uncountable",
          "grammar:future-forms",
          "grammar:gerund-infinitive",
          "grammar:modal-verb",
          "grammar:passive-voice",
          "grammar:past-perfect",
          "grammar:past-simple",
          "grammar:preposition",
          "grammar:present-perfect",
          "grammar:present-simple-continuous",
          "grammar:pronoun",
          "grammar:question-form",
          "grammar:relative-clause",
          "grammar:reported-speech",
          "grammar:subject-verb-agreement",
          "grammar:word-order",
          "phoneme:/æ/",
          "phoneme:/aɪ/",
          "phoneme:/aɪɹ/",
          "phoneme:/aʊ/",
          "phoneme:/aʊɹ/",
          "phoneme:/ɑ/",
