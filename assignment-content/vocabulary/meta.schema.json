          "vocab:idiom",
          "vocab:phrasal-verb",
          "vocab:register",
          "vocab:word-choice",
          "vocab:word-form"
        ]
      },
      "uniqueItems": true,
      "description": "Error taxonomy tags this item trains, from apps/api/rules/error-taxonomy.yaml (v2)"
    }
  },
  "required": [
    "title",
    "cefr_level",
    "topic",
    "skills",
    "difficulty",
    "source",
    "questions",
    "target_tags"
  ],
  "additionalProperties": false
}
