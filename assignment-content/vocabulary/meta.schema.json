          "phoneme:/ə/",
          "phoneme:/ɛ/",
          "phoneme:/ɛɹ/",
          "phoneme:/ɚ/",
          "phoneme:/ɝ/",
          "phoneme:/f/",
          "phoneme:/g/",
          "phoneme:/h/",
          "phoneme:/i/",
          "phoneme:/ɪ/",
          "phoneme:/ɪɹ/",
          "phoneme:/j/",
          "phoneme:/ju/",
          "phoneme:/k/",
          "phoneme:/l/",
          "phoneme:/m/",
          "phoneme:/n/",
          "phoneme:/ŋ/",
          "phoneme:/oʊ/",
          "phoneme:/ɔ/",
