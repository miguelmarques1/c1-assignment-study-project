# Copy to .env and fill in the values marked CHANGE ME.
# Every variable the stack reads is listed here.

# ---------------------------------------------------------------------------
# Ports published to the host
# ---------------------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# ---------------------------------------------------------------------------
# PostgreSQL
# DATABASE_URL is injected into the api container by docker-compose using the
# values below. Set it explicitly only when running the API outside Docker.
# ---------------------------------------------------------------------------
POSTGRES_USER=english_quest
POSTGRES_PASSWORD=english_quest
POSTGRES_DB=english_quest
DATABASE_URL=postgresql://english_quest:english_quest@localhost:5432/english_quest?schema=public

# ---------------------------------------------------------------------------
# Redis — sessions, login throttling and, from F08 onward, the job queues
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Session
# SESSION_SECRET signs the session cookie. The API refuses to boot when it is
# missing or shorter than 32 characters.
# Generate one with: openssl rand -base64 48
# ---------------------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_generate_a_secret_of_at_least_32_characters
SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Login throttling
# ---------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, S3-compatible later)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=english-quest

# ---------------------------------------------------------------------------
# LiveKit — probed by /health from F01, used for real rooms from F05
# Must match the key pair in livekit.yaml.
# LIVEKIT_URL is the container-internal address the API uses to call the
# server SDK; LIVEKIT_WS_URL is the browser-reachable address handed to the
# web client alongside a token.
# ---------------------------------------------------------------------------
LIVEKIT_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_local_only_change_me_32chars

# ---------------------------------------------------------------------------
# Live Classroom (F05)
# Configuration, not a constant: raising this admits another learner with no
# schema change and no pipeline change. Supported up to 4.
# ---------------------------------------------------------------------------
LESSON_MAX_PARTICIPANTS=2

# ---------------------------------------------------------------------------
# Seed accounts
# A JSON array. Add or remove entries freely — the seed is idempotent by email
# and never touches accounts it does not list.
# ---------------------------------------------------------------------------
SEED_USERS=[{"email":"you@example.com","displayName":"You","password":"CHANGE_ME_at_least_10_chars"},{"email":"partner@example.com","displayName":"Partner","password":"CHANGE_ME_at_least_10_chars"}]

# ---------------------------------------------------------------------------
# Web client
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# BYOK credential vault
# Encrypts the API keys users store. It is NOT a provider credential and has no
# fallback role: it is the key to the vault, not something kept inside it.
# Generate with: openssl rand -base64 32
# Changing or losing it while credentials are stored stops the API from booting.
# ---------------------------------------------------------------------------
BYOK_MASTER_KEY=CHANGE_ME_32_bytes_of_base64

# Real provider credentials used only by the live verification script.
# TEST_GEMINI_API_KEY=
# TEST_AZURE_SPEECH_API_KEY=
# TEST_AZURE_SPEECH_REGION=eastus2
