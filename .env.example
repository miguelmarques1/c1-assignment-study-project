DATABASE_URL="postgresql://videomax:videomax@localhost:5433/videomax"
SESSION_SECRET="change-me-to-a-32-byte-minimum-random-string"
APP_PORT="3001"
VIDEO_STORAGE_ROOT="storage/videos"
VIDEO_MAX_BYTES="2147483648"

# F07 — Background Processing Pipeline
# OpenAI credentials used by the transcribe (Whisper) and summarize (GPT-4.1 nano) stages.
OPENAI_API_KEY=""
# Model overrides (leave defaults unless you have a reason to change them).
WHISPER_MODEL="whisper-1"
SUMMARY_MODEL="gpt-4.1-nano"
# Cap on characters fed to the summarizer (~30k tokens). Longer transcripts are middle-out truncated.
SUMMARY_INPUT_MAX_CHARS="120000"
# Worker loop tuning. Set VIDEOMAX_PIPELINE_ENABLED=0 to disable the worker (useful in CI).
VIDEOMAX_PIPELINE_ENABLED="1"
VIDEOMAX_PIPELINE_CONCURRENCY="2"
VIDEOMAX_PIPELINE_POLL_INTERVAL_MS="2000"
VIDEOMAX_PIPELINE_LEASE_TIMEOUT_MS="900000"
# Integration tests set this to "1" to swap the real OpenAI client for a deterministic fake.
OPENAI_FAKE="0"
