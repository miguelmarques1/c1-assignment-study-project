generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Accounts come from the seed command or from a direct insert. There is no
/// registration flow, and nothing in the data model caps how many users exist.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lowercased; a check constraint enforces it even for direct inserts.
  email        String   @unique(map: "users_email_key") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(100)
  /// bcrypt output at cost factor 12 — always 60 characters.
  passwordHash String   @map("password_hash") @db.Char(60)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  credentials       UserCredential[]
  credentialUsage   CredentialUsage[]
  promptExecutions  PromptExecution[]
  lessonsOpened     Lesson[]            @relation("LessonOpener")
  lessonsEnded      Lesson[]            @relation("LessonEnder")
  lessonParticipations LessonParticipant[]
  scenariosGenerated   LessonScenario[]
  roleCards            LessonRoleCard[]

  @@map("users")
}

/// One row per user per provider. The master key lives in the environment, never
/// here, so a database dump on its own reveals nothing usable.
model UserCredential {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  provider        String    @db.VarChar(32)
  ciphertext      Bytes
  iv              Bytes
  authTag         Bytes     @map("auth_tag")
  /// Plain, for display only — the settings screen must not decrypt to render.
  lastFour        String    @map("last_four") @db.Char(4)
  region          String?   @db.VarChar(40)
  status          String    @default("unverified") @db.VarChar(16)
  lastValidatedAt DateTime? @map("last_validated_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider], map: "user_credentials_user_provider_key")
  @@map("user_credentials")
}

/// Append-only audit of every key use. Deliberately has no column that could
/// carry key material.
model CredentialUsage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String   @db.VarChar(32)
  feature    String   @db.VarChar(64)
  outcome    String   @db.VarChar(24)
  errorCode  String?  @map("error_code") @db.VarChar(64)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, occurredAt(sort: Desc)], map: "ix_credential_usage_user_provider_time")
  @@map("credential_usage")
}

/// Append-only telemetry, one row per PromptExecutionService.execute() call
/// (not per Gemini request — a retried-and-recovered call is one row).
/// rawResponse is populated only on validation_failed_hard_error, per the
/// PRD's "raw response retained for inspection".
model PromptExecution {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  promptId       String   @map("prompt_id") @db.VarChar(64)
  promptVersion  String   @map("prompt_version") @db.VarChar(16)
  model          String   @db.VarChar(64)
  temperature    Float    @db.Real
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  latencyMs      Int      @map("latency_ms")
  outcome        String   @db.VarChar(32)
  rawResponse    String?  @map("raw_response")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promptId, promptVersion, occurredAt(sort: Desc)], map: "ix_prompt_execution_prompt_version_time")
  @@map("prompt_execution")
}

/// The live-session lifecycle only — a lesson whose recording failed is a
/// separate fact on F07's own column, not a value of `status` here.
///
/// `ux_lessons_open_room`, the partial unique index that keeps at most one
/// lesson open per room, is created by raw SQL in this model's migration and
/// is deliberately NOT declared as a Prisma `@@unique` — the schema language
/// has no partial-index syntax. A future `prisma migrate dev` run will not
/// see it as part of the desired state and may propose dropping it; reject
/// that part of any generated migration by hand.
model Lesson {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room                   String    @db.VarChar(64)
  status                 String    @default("waiting") @db.VarChar(24)
  openedBy               String    @map("opened_by") @db.Uuid
  openedAt               DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  startedAt              DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt                DateTime? @map("ended_at") @db.Timestamptz(6)
  durationSeconds        Int?      @map("duration_seconds")
  /// One of ended_by_participant, all_disconnected, max_duration, abandoned_before_start.
  endReason              String?   @map("end_reason") @db.VarChar(32)
  endedBy                String?   @map("ended_by") @db.Uuid
  /// Stamped when the last connected participant leaves; cleared on any join.
  /// The sweeper's only input for the 60-second all-disconnected rule.
  allDisconnectedSince   DateTime? @map("all_disconnected_since") @db.Timestamptz(6)
  /// The cap in force when this lesson opened, so a later configuration
  /// change never rewrites history.
  maxParticipants        Int       @map("max_participants") @db.SmallInt
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  opener       User                @relation("LessonOpener", fields: [openedBy], references: [id], onDelete: Restrict)
  ender        User?               @relation("LessonEnder", fields: [endedBy], references: [id], onDelete: SetNull)
  participants LessonParticipant[]
  scenario     LessonScenario?
  roleCards    LessonRoleCard[]

  @@index([status, openedAt(sort: Desc)], map: "ix_lessons_status_opened")
  @@map("lessons")
}

/// One row per participant per lesson. `identity` is stored explicitly rather
/// than assumed equal to `userId` so F07 joins egress tracks on a recorded
/// fact, not a re-derived assumption.
model LessonParticipant {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId           String    @map("lesson_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  identity           String    @db.VarChar(64)
  /// This participant's own first connection — what a late arrival is
  /// recorded from, independent of the lesson's own `started_at`.
  joinedAt           DateTime  @map("joined_at") @db.Timestamptz(6)
  leftAt             DateTime? @map("left_at") @db.Timestamptz(6)
  lastConnectedAt    DateTime? @map("last_connected_at") @db.Timestamptz(6)
  lastDisconnectedAt DateTime? @map("last_disconnected_at") @db.Timestamptz(6)
  connected          Boolean   @default(false)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId], map: "ux_lesson_participants_lesson_user")
  @@index([userId, joinedAt(sort: Desc)], map: "ix_lesson_participants_user_joined")
  @@map("lesson_participants")
}

/// The shared situation — every participant sees it. Created the moment the
/// lesson opens, before any model call, so `pending`, `failed` and
/// `no_scenario` are states of a row rather than the absence of one; F11
/// reads that status to be told explicitly when no scenario was in play.
///
/// Generated from no profile data of any participant, with the opener's own
/// key. `vocabularyDomain` is chosen server-side from the PRD's fifteen and
/// is the value F20 counts, never the model's echo of it.
model LessonScenario {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId         String   @unique(map: "ux_lesson_scenarios_lesson") @map("lesson_id") @db.Uuid
  /// One of pending, ready, failed, no_scenario.
  status           String   @default("pending") @db.VarChar(16)
  setting          String?
  premise          String?
  vocabularyDomain String?  @map("vocabulary_domain") @db.VarChar(48)
  /// `[{ label, relationship }]`, one per seat (`lessons.max_participants`).
  roles            Json?
  discussionHooks  Json?    @map("discussion_hooks")
  /// Bounded at 3 by a check constraint in the migration.
  rerollCount      Int      @default(0) @map("reroll_count") @db.SmallInt
  generatedBy      String?  @map("generated_by") @db.Uuid
  promptId         String?  @map("prompt_id") @db.VarChar(64)
  promptVersion    String?  @map("prompt_version") @db.VarChar(16)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  generator User?  @relation(fields: [generatedBy], references: [id], onDelete: SetNull)

  @@index([vocabularyDomain], map: "ix_lesson_scenarios_domain")
  @@map("lesson_scenarios")
}

/// One participant's private role card. `userId` is the only person who may
/// ever read this row — a product invariant, not a UI concern, so no later
/// feature should read another participant's card either.
///
/// The column behind `constraintText` is `constraint_text` because
/// CONSTRAINT is a reserved word in PostgreSQL; the API and client contracts
/// keep the PRD's `constraint`.
model LessonRoleCard {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId          String   @map("lesson_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// Drawn at random from the situation's unassigned labels; null while the
  /// situation is still pending.
  roleLabel         String?  @map("role_label") @db.VarChar(120)
  /// One of pending, ready, failed.
  status            String   @default("pending") @db.VarChar(16)
  background        String?
  objective         String?
  constraintText    String?  @map("constraint_text")
  /// One of formal, neutral, informal.
  register          String?  @db.VarChar(16)
  targetExpressions Json?    @map("target_expressions")
  promptId          String?  @map("prompt_id") @db.VarChar(64)
  promptVersion     String?  @map("prompt_version") @db.VarChar(16)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId], map: "ux_lesson_role_cards_lesson_user")
  @@map("lesson_role_cards")
}
