generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Accounts come from the seed command or from a direct insert. There is no
/// registration flow, and nothing in the data model caps how many users exist.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lowercased; a check constraint enforces it even for direct inserts.
  email        String   @unique(map: "users_email_key") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(100)
  /// bcrypt output at cost factor 12 — always 60 characters.
  passwordHash String   @map("password_hash") @db.Char(60)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  credentials          UserCredential[]
  credentialUsage      CredentialUsage[]
  promptExecutions     PromptExecution[]
  lessonsOpened        Lesson[]                    @relation("LessonOpener")
  lessonsEnded         Lesson[]                    @relation("LessonEnder")
  lessonParticipations LessonParticipant[]
  scenariosGenerated   LessonScenario[]
  roleCards            LessonRoleCard[]
  recordingSegments    LessonRecordingSegment[]
  pipelineBranches     LessonPipelineBranch[]
  transcripts          LessonTranscript[]
  utterances           LessonUtterance[]
  excerptSelections    LessonExcerptSelection[]
  excerpts             LessonExcerpt[]
  excerptAssessments   LessonExcerptAssessment[]
  pronunciationResults LessonPronunciationResult[]
  analyses             LessonAnalysis[]
  analysisErrors       LessonAnalysisError[]
  learningProfile      LearningProfile?
  profileSources       ProfileSource[]
  profileMeasurements  ProfileMeasurement[]
  profileCompetencies  ProfileCompetency[]
  ledgerEntries        ErrorLedgerEntry[]
  ledgerOccurrences    ErrorLedgerOccurrence[]
  ledgerEncounters     ErrorLedgerEncounter[]
  contentServings      ContentItemServing[]
  generationRuns       ContentGenerationRun[]
  generationSlots      ContentGenerationSlot[]
  studyPlans           StudyPlan[]
  studyPlanActivities  StudyPlanActivity[]
  studyPlanRequests    StudyPlanRequest[]
  writingTasks         WritingTask[]
  writingCorrections   WritingCorrection[]
  speakingTasks        SpeakingTask[]
  speakingAttempts     SpeakingAttempt[]

  @@map("users")
}

/// One row per user per provider. The master key lives in the environment, never
/// here, so a database dump on its own reveals nothing usable.
model UserCredential {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  provider        String    @db.VarChar(32)
  ciphertext      Bytes
  iv              Bytes
  authTag         Bytes     @map("auth_tag")
  /// Plain, for display only — the settings screen must not decrypt to render.
  lastFour        String    @map("last_four") @db.Char(4)
  region          String?   @db.VarChar(40)
  status          String    @default("unverified") @db.VarChar(16)
  lastValidatedAt DateTime? @map("last_validated_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider], map: "user_credentials_user_provider_key")
  @@map("user_credentials")
}

/// Append-only audit of every key use. Deliberately has no column that could
/// carry key material.
model CredentialUsage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String   @db.VarChar(32)
  feature    String   @db.VarChar(64)
  outcome    String   @db.VarChar(24)
  errorCode  String?  @map("error_code") @db.VarChar(64)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, occurredAt(sort: Desc)], map: "ix_credential_usage_user_provider_time")
  @@map("credential_usage")
}

/// Append-only telemetry, one row per PromptExecutionService.execute() call
/// (not per Gemini request — a retried-and-recovered call is one row).
/// rawResponse is populated only on validation_failed_hard_error, per the
/// PRD's "raw response retained for inspection".
model PromptExecution {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  promptId      String   @map("prompt_id") @db.VarChar(64)
  promptVersion String   @map("prompt_version") @db.VarChar(16)
  model         String   @db.VarChar(64)
  temperature   Float    @db.Real
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int      @map("latency_ms")
  outcome       String   @db.VarChar(32)
  rawResponse   String?  @map("raw_response")
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promptId, promptVersion, occurredAt(sort: Desc)], map: "ix_prompt_execution_prompt_version_time")
  @@map("prompt_execution")
}

/// The live-session lifecycle only — a lesson whose recording failed is a
/// separate fact on F07's own column, not a value of `status` here.
///
/// `ux_lessons_open_room`, the partial unique index that keeps at most one
/// lesson open per room, is created by raw SQL in this model's migration and
/// is deliberately NOT declared as a Prisma `@@unique` — the schema language
/// has no partial-index syntax. A future `prisma migrate dev` run will not
/// see it as part of the desired state and may propose dropping it; reject
/// that part of any generated migration by hand.
///
/// F07 (0007_lesson_recording) adds a second partial index the same way:
/// `ix_lessons_recording_pending` on `recording_status`, scoped to the
/// non-terminal values the finalization job scans. Also not declared here.
model Lesson {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room                     String    @db.VarChar(64)
  status                   String    @default("waiting") @db.VarChar(24)
  openedBy                 String    @map("opened_by") @db.Uuid
  openedAt                 DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  startedAt                DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt                  DateTime? @map("ended_at") @db.Timestamptz(6)
  durationSeconds          Int?      @map("duration_seconds")
  /// One of ended_by_participant, all_disconnected, max_duration, abandoned_before_start.
  endReason                String?   @map("end_reason") @db.VarChar(32)
  endedBy                  String?   @map("ended_by") @db.Uuid
  /// Stamped when the last connected participant leaves; cleared on any join.
  /// The sweeper's only input for the 60-second all-disconnected rule.
  allDisconnectedSince     DateTime? @map("all_disconnected_since") @db.Timestamptz(6)
  /// The cap in force when this lesson opened, so a later configuration
  /// change never rewrites history.
  maxParticipants          Int       @map("max_participants") @db.SmallInt
  /// F07: the whole-lesson recording lifecycle. One of idle, starting,
  /// recording, not_recording, finalizing, recorded, recording_partial,
  /// recording_failed, too_short, storage_unavailable.
  recordingStatus          String    @default("idle") @map("recording_status") @db.VarChar(24)
  /// First egress of the lesson active — the live indicator's `since`.
  recordingStartedAt       DateTime? @map("recording_started_at") @db.Timestamptz(6)
  /// When finalization began; the 120-second egress settle window counts from here.
  recordingFinalizingSince DateTime? @map("recording_finalizing_since") @db.Timestamptz(6)
  /// First storage transport error of the current finalization pass; the
  /// 2-minute window counts from here, cleared on success or a retry.
  storageUnavailableSince  DateTime? @map("storage_unavailable_since") @db.Timestamptz(6)
  /// When the lesson reached a final recording status.
  recordingFinalizedAt     DateTime? @map("recording_finalized_at") @db.Timestamptz(6)
  /// Finalization lease — a pass claims this row only when null or past.
  recordingLeaseUntil      DateTime? @map("recording_lease_until") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  opener               User                        @relation("LessonOpener", fields: [openedBy], references: [id], onDelete: Restrict)
  ender                User?                       @relation("LessonEnder", fields: [endedBy], references: [id], onDelete: SetNull)
  participants         LessonParticipant[]
  scenario             LessonScenario?
  roleCards            LessonRoleCard[]
  recordingSegments    LessonRecordingSegment[]
  pipelineBranches     LessonPipelineBranch[]
  transcripts          LessonTranscript[]
  utterances           LessonUtterance[]
  excerptSelections    LessonExcerptSelection[]
  excerpts             LessonExcerpt[]
  excerptAssessments   LessonExcerptAssessment[]
  pronunciationResults LessonPronunciationResult[]
  analyses             LessonAnalysis[]
  analysisErrors       LessonAnalysisError[]
  profileSources       ProfileSource[]
  ledgerOccurrences    ErrorLedgerOccurrence[]
  studyPlans           StudyPlan[]
  studyPlanRequests    StudyPlanRequest[]

  @@index([status, openedAt(sort: Desc)], map: "ix_lessons_status_opened")
  @@map("lessons")
}

/// One row per participant per lesson. `identity` is stored explicitly rather
/// than assumed equal to `userId` so F07 joins egress tracks on a recorded
/// fact, not a re-derived assumption.
model LessonParticipant {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId           String    @map("lesson_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  identity           String    @db.VarChar(64)
  /// This participant's own first connection — what a late arrival is
  /// recorded from, independent of the lesson's own `started_at`.
  joinedAt           DateTime  @map("joined_at") @db.Timestamptz(6)
  leftAt             DateTime? @map("left_at") @db.Timestamptz(6)
  lastConnectedAt    DateTime? @map("last_connected_at") @db.Timestamptz(6)
  lastDisconnectedAt DateTime? @map("last_disconnected_at") @db.Timestamptz(6)
  connected          Boolean   @default(false)
  /// F07: this participant's own recording outcome. One of not_started,
  /// recording, stopped, failed_to_start, complete, partial, missing.
  recordingStatus    String    @default("not_started") @map("recording_status") @db.VarChar(24)
  /// `lessons/{lessonId}/{userId}/audio.ogg` once verified — what F08 and F10 read.
  audioObjectKey     String?   @map("audio_object_key") @db.VarChar(255)
  /// Verified size; a check constraint pairs it with the key and floors it above 10 KB.
  audioBytes         BigInt?   @map("audio_bytes")
  /// Second 0 of this participant's `audio.ogg`.
  recordingStartedAt DateTime? @map("recording_started_at") @db.Timestamptz(6)
  /// Assembled file length, filled gaps included.
  audioDurationMs    Int?      @map("audio_duration_ms")
  /// Sum of segment durations; the per-participant 3-minute rule reads this.
  capturedMs         Int?      @map("captured_ms")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId], map: "ux_lesson_participants_lesson_user")
  @@index([userId, joinedAt(sort: Desc)], map: "ix_lesson_participants_user_joined")
  @@map("lesson_participants")
}

/// One row per egress (one per published microphone track, plus a restart
/// row on an unexpected end or a reconnect). Finalization assembles a
/// participant's segments, in `fileStartedAt` order, into one continuous
/// `audio.ogg` and deletes them once that object is verified.
model LessonRecordingSegment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId      String    @map("lesson_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  trackSid      String    @map("track_sid") @db.VarChar(64)
  /// Null until LiveKit accepted the request; stays null for a start that never succeeded.
  egressId      String?   @unique(map: "ux_segments_egress") @map("egress_id") @db.VarChar(64)
  objectKey     String    @map("object_key") @db.VarChar(255)
  /// One of requested, starting, active, ending, complete, failed.
  status        String    @default("requested") @db.VarChar(16)
  attempt       Int       @default(1) @db.SmallInt
  /// Ended abnormally while the lesson was still live — triggers the single restart.
  unexpected    Boolean   @default(false)
  /// LiveKit's error for a failed start or end; never shown to users.
  error         String?   @db.VarChar(500)
  fileStartedAt DateTime? @map("file_started_at") @db.Timestamptz(6)
  fileEndedAt   DateTime? @map("file_ended_at") @db.Timestamptz(6)
  durationMs    Int?      @map("duration_ms")
  sizeBytes     BigInt?   @map("size_bytes")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `ux_segments_open_track`, the partial unique index that keeps at most
  /// one open egress per track (requested/starting/active/ending), is
  /// created by raw SQL in this model's migration and deliberately NOT
  /// declared as a Prisma `@@unique` — same reasoning as `ux_lessons_open_room`.
  @@index([lessonId, userId, fileStartedAt], map: "ix_segments_lesson_user_started")
  @@map("lesson_recording_segments")
}

/// One row per participant per lesson, extended by later features as the
/// pipeline grows past recording. `stage`/`status`/`failureCode` are widened
/// by each feature's own migration rather than replaced.
model LessonPipelineBranch {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId            String    @map("lesson_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  /// Where the branch is now. One of recording, transcription,
  /// excerpt_selection (F08), pronunciation_assessment (F09); later stages
  /// widen the check.
  stage               String    @default("recording") @db.VarChar(24)
  /// The current stage's status. One of verifying, queued, running,
  /// retrying, blocked_missing_key, failed, storage_unavailable, completed
  /// (F15: reached once `plan_generation`, the pipeline's last stage, completes).
  status              String    @default("verifying") @db.VarChar(24)
  /// Set exactly when status = failed: F07's recording codes, or the failed
  /// stage row's reason code once the branch moved past recording.
  failureCode         String?   @map("failure_code") @db.VarChar(40)
  failureReason       String?   @map("failure_reason") @db.VarChar(200)
  attempts            Int       @default(1) @db.SmallInt
  /// When PipelineLaunchPort.launch was called; guards against a second call.
  launchedAt          DateTime? @map("launched_at") @db.Timestamptz(6)
  /// When StudyPlanFallbackPort.requestFallbackPlan was called (F15); guards against a second call.
  fallbackRequestedAt DateTime? @map("fallback_requested_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages LessonPipelineStage[]

  @@unique([lessonId, userId], map: "ux_branches_lesson_user")
  @@index([stage, status], map: "ix_branches_stage_status")
  @@index([userId, createdAt(sort: Desc)], map: "ix_branches_user_created")
  @@map("lesson_pipeline_branches")
}

/// F08: one row per branch per stage, from `transcription` onward. The
/// branch's own `stage`/`status` is the pointer to the current one and is
/// written in the same transaction; this row is what holds each stage's
/// timing, attempts and reason, so F19 can show every stage's duration.
model LessonPipelineStage {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  /// One of transcription, excerpt_selection, pronunciation_assessment;
  /// later stages widen the check.
  stage           String    @db.VarChar(24)
  /// One of queued, running, retrying, blocked_missing_key, failed, completed.
  status          String    @default("queued") @db.VarChar(24)
  /// Starts of this stage (launch, resume from blocked, manual retry); part of the job id.
  run             Int       @default(1) @db.SmallInt
  /// Handler executions across every run; never reset.
  attempts        Int       @default(0) @db.SmallInt
  queuedAt        DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  /// First attempt of the current run — elapsed time counts from here.
  startedAt       DateTime? @map("started_at") @db.Timestamptz(6)
  lastAttemptAt   DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  /// Set only while retrying.
  nextAttemptAt   DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  /// Set exactly for completed and failed.
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  reasonCode      String?   @map("reason_code") @db.VarChar(40)
  reason          String?   @db.VarChar(200)
  /// The provider's own wording, scrubbed of the key.
  providerMessage String?   @map("provider_message") @db.VarChar(500)
  /// azure_speech or gemini — set exactly while blocked, so the drain knows which key to look for.
  blockedProvider String?   @map("blocked_provider") @db.VarChar(32)
  /// F10: settled units of work in the current run; null for stages that never report progress.
  progressDone    Int?      @map("progress_done") @db.SmallInt
  /// F10: units of work in the current run; null for stages that never report progress.
  progressTotal   Int?      @map("progress_total") @db.SmallInt
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch LessonPipelineBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// `ix_stages_pending`, the partial index over the pending statuses the
  /// drain scans, is created by raw SQL in this model's migration and
  /// deliberately NOT declared here — same reasoning as `ux_lessons_open_room`.
  @@unique([branchId, stage], map: "ux_stages_branch_stage")
  @@map("lesson_pipeline_stages")
}

/// F08: one transcript per participant per lesson, with the provenance of
/// the run that produced it — the transcription counterpart of the prompt
/// id and version every generated artifact stores.
model LessonTranscript {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId        String   @map("lesson_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// azure_fast_transcription.
  provider        String   @db.VarChar(40)
  apiVersion      String   @map("api_version") @db.VarChar(16)
  locale          String   @db.VarChar(16)
  /// As the provider reported it.
  audioDurationMs Int?     @map("audio_duration_ms")
  /// Wall time of the successful request — the evidence for the 10-minute target.
  latencyMs       Int      @map("latency_ms")
  /// Never zero: an empty result fails the stage instead of being stored.
  utteranceCount  Int      @map("utterance_count")
  wordCount       Int      @map("word_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lesson            Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  utterances        LessonUtterance[]
  excerptSelections LessonExcerptSelection[]

  @@unique([lessonId, userId], map: "ux_transcripts_lesson_user")
  @@map("lesson_transcripts")
}

/// F08: one recognized phrase of one participant's track. `startMs`/`endMs`
/// are offsets in that participant's `audio.ogg` (what F10 slices by), not
/// lesson time — the merged transcript shifts them by the participant's
/// `recording_started_at`.
model LessonUtterance {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transcriptId String   @map("transcript_id") @db.Uuid
  lessonId     String   @map("lesson_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  /// 0-based order within the participant's track.
  idx          Int
  startMs      Int      @map("start_ms")
  endMs        Int      @map("end_ms")
  text         String
  /// Phrase recognition confidence, 0–1.
  confidence   Float?   @db.Real
  /// `[{ text, startMs, durationMs, confidence }]`, offsets in the file;
  /// `confidence` is null from fast transcription.
  words        Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transcript        LessonTranscript        @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  lesson            Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  excerpt           LessonExcerpt?
  analysisErrors    LessonAnalysisError[]
  ledgerOccurrences ErrorLedgerOccurrence[]

  @@unique([lessonId, userId, idx], map: "ux_utterances_lesson_user_idx")
  @@index([transcriptId], map: "ix_utterances_transcript")
  @@map("lesson_utterances")
}

/// F09: which of one participant's utterances pronunciation assessment
/// (F10) will spend their Azure quota on, and under which rules. The rule
/// version, fingerprint and snapshot, plus the pronunciation focus used as
/// input, are what make a selection reproducible and comparable after the
/// thresholds are retuned. Computed from one transcript, and deleted with it.
model LessonExcerptSelection {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId        String   @map("lesson_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  transcriptId    String   @map("transcript_id") @db.Uuid
  /// `version` from rules/excerpt-selection.yaml.
  ruleVersion     String   @map("rule_version") @db.VarChar(32)
  /// sha256 hex of the thresholds and the sorted lexicon.
  ruleFingerprint String   @map("rule_fingerprint") @db.Char(64)
  /// Snapshot of the rules in force.
  rules           Json
  /// `none` until F12 provides the ledger's pronunciation focus.
  focusSource     String   @map("focus_source") @db.VarChar(40)
  /// The unmastered pronunciation tags used as input; a JSON array.
  focusTags       Json     @map("focus_tags")
  utteranceCount  Int      @map("utterance_count")
  eligibleCount   Int      @map("eligible_count")
  selectedCount   Int      @map("selected_count")
  selectedAudioMs Int      @map("selected_audio_ms")
  /// `sparse_pronunciation_sample`: fewer than the rules' `sparse_below` selected.
  sparseSample    Boolean  @map("sparse_sample")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lesson               Lesson                      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript           LessonTranscript            @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  excerpts             LessonExcerpt[]
  pronunciationResults LessonPronunciationResult[]

  @@unique([lessonId, userId], map: "ux_excerpt_selections_lesson_user")
  @@index([transcriptId], map: "ix_excerpt_selections_transcript")
  @@map("lesson_excerpt_selections")
}

/// F09: one selected utterance, self-contained for F10: its range in the
/// participant's `audio.ogg` (file offsets, not lesson time) and its text as
/// the reference, both copied from the utterance, plus the metrics it was
/// ranked on and the badge sentence.
model LessonExcerpt {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  selectionId          String   @map("selection_id") @db.Uuid
  lessonId             String   @map("lesson_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  utteranceId          String   @map("utterance_id") @db.Uuid
  /// 1-based order in which the selection accepted it.
  rank                 Int      @db.SmallInt
  startMs              Int      @map("start_ms")
  endMs                Int      @map("end_ms")
  referenceText        String   @map("reference_text")
  selectionRuleVersion String   @map("selection_rule_version") @db.VarChar(32)
  /// The confidence it was ranked on; null when unknown.
  confidence           Float?   @db.Real
  wordCount            Int      @map("word_count") @db.SmallInt
  fillerShare          Float    @map("filler_share") @db.Real
  focusWordCount       Int      @map("focus_word_count") @db.SmallInt
  reason               String   @db.VarChar(200)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  selection  LessonExcerptSelection   @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  lesson     Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  utterance  LessonUtterance          @relation(fields: [utteranceId], references: [id], onDelete: Cascade)
  assessment LessonExcerptAssessment?

  @@unique([selectionId, rank], map: "ux_excerpts_selection_rank")
  @@unique([utteranceId], map: "ux_excerpts_utterance")
  @@index([lessonId, userId], map: "ix_excerpts_lesson_user")
  @@map("lesson_excerpts")
}

/// F10: one row per excerpt, written as it settles rather than only inside the
/// stage's completing transaction — the state a per-excerpt retry, a resume
/// from blocked, and the `N of M` counter all need to survive between runs.
model LessonExcerptAssessment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  excerptId      String    @unique(map: "ux_excerpt_assessments_excerpt") @map("excerpt_id") @db.Uuid
  lessonId       String    @map("lesson_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// One of pending, assessed, failed, dropped, abandoned.
  status         String    @default("pending") @db.VarChar(16)
  /// Requests sent, across every run.
  attempts       Int       @default(0) @db.SmallInt
  /// One of service_error, audio_rejected, no_speech_recognized, slice_failed, quota_exhausted.
  failureCode    String?   @map("failure_code") @db.VarChar(32)
  /// Provider or ffmpeg wording, scrubbed.
  failureMessage String?   @map("failure_message") @db.VarChar(500)
  /// Range actually cut (file offsets); equals the excerpt's.
  clipStartMs    Int?      @map("clip_start_ms")
  clipEndMs      Int?      @map("clip_end_ms")
  pronunciation  Float?    @db.Real
  accuracy       Float?    @db.Real
  fluency        Float?    @db.Real
  /// Null where the locale has no prosody.
  prosody        Float?    @db.Real
  completeness   Float?    @db.Real
  /// `[{ word, accuracy, errorTypes[], offsetMs, durationMs, phonemes[{ phoneme, accuracy, offsetMs, durationMs }] }]`, offsets relative to the clip.
  words          Json?
  /// Azure's `Display`.
  recognizedText String?   @map("recognized_text")
  latencyMs      Int?      @map("latency_ms")
  assessedAt     DateTime? @map("assessed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  excerpt LessonExcerpt @relation(fields: [excerptId], references: [id], onDelete: Cascade)
  lesson  Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId, userId], map: "ix_excerpt_assessments_lesson_user")
  @@map("lesson_excerpt_assessments")
}

/// F10: the per-lesson aggregate F11, F12 and F19 read, written once in the
/// stage's completing transaction, replacing any earlier attempt for the
/// same participant.
model LessonPronunciationResult {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId          String   @map("lesson_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// F09's selection it was computed from.
  selectionId       String   @map("selection_id") @db.Uuid
  /// assessed or no_sample.
  status            String   @db.VarChar(16)
  excerptCount      Int      @map("excerpt_count") @db.SmallInt
  assessedCount     Int      @map("assessed_count") @db.SmallInt
  partialAssessment Boolean  @map("partial_assessment")
  /// Copied from the selection.
  sparseSample      Boolean  @map("sparse_sample")
  quotaExhausted    Boolean  @map("quota_exhausted")
  /// Duration-weighted mean; null for no_sample.
  pronunciation     Float?   @db.Real
  accuracy          Float?   @db.Real
  fluency           Float?   @db.Real
  /// Null when no excerpt reported prosody.
  prosody           Float?   @db.Real
  completeness      Float?   @db.Real
  assessedAudioMs   Int      @map("assessed_audio_ms")
  /// `[{ phoneme, meanAccuracy, occurrences, exampleWord, exampleExcerptId, exampleUtteranceId }]`.
  worstPhonemes     Json     @map("worst_phonemes")
  /// `[{ word, meanAccuracy, occurrences, errorTypes[], exampleExcerptId, exampleUtteranceId }]`.
  worstWords        Json     @map("worst_words")
  /// `[{ tag: "phoneme:/θ/", phoneme, occurrences, meanAccuracy, exampleWords[] }]`, what F12 ingests.
  phonemeTags       Json     @map("phoneme_tags")
  provider          String   @db.VarChar(40)
  locale            String   @db.VarChar(16)
  phonemeAlphabet   String   @map("phoneme_alphabet") @db.VarChar(8)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lesson    Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  selection LessonExcerptSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId], map: "ux_pronunciation_results_lesson_user")
  @@index([selectionId], map: "ix_pronunciation_results_selection")
  @@map("lesson_pronunciation_results")
}

/// F11: one analysis per participant per lesson, produced with that
/// participant's own Gemini key. Replaced (with its errors, on cascade)
/// whenever the stage re-runs, so a retry never leaves two analyses for the
/// same participant. `scenarioFit` is set only for `scenario_context = full`.
model LessonAnalysis {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId                  String   @map("lesson_id") @db.Uuid
  userId                    String   @map("user_id") @db.Uuid
  grammar                   Int      @db.SmallInt
  vocabulary                Int      @db.SmallInt
  fluency                   Int      @db.SmallInt
  interaction               Int      @db.SmallInt
  comprehension             Int      @db.SmallInt
  /// `{ grammar, vocabulary, fluency, interaction, comprehension }`: one sentence each.
  justifications            Json
  /// 3–5 strings.
  strengths                 Json
  /// Tags flagged as recurring, filtered against the kept errors and the profile's own weakness tags.
  recurringTags             Json     @map("recurring_tags")
  /// 3–6 strings.
  topics                    Json
  /// One of full, situation_only, none.
  scenarioContext           String   @map("scenario_context") @db.VarChar(16)
  /// `{ roleLabel, registerExpected, registerMatched, registerComment, expressionsUsed[], expressionsNotUsed[] }`, only for `full`.
  scenarioFit               Json?    @map("scenario_fit")
  /// assessed or no_sample (F10's result).
  pronunciationContext      String   @map("pronunciation_context") @db.VarChar(16)
  transcriptTokensEstimated Int      @map("transcript_tokens_estimated")
  transcriptTruncated       Boolean  @map("transcript_truncated")
  /// `{ othersOmittedBeforeMs, ownOmittedBeforeMs, droppedOthers, droppedOwn }` when truncated.
  truncation                Json?
  /// Weakness tags sent from the profile port.
  profileTagCount           Int      @default(0) @map("profile_tag_count") @db.SmallInt
  /// Errors whose quote was not found in the owner's own utterances.
  discardedErrorCount       Int      @default(0) @map("discarded_error_count") @db.SmallInt
  /// `no_errors_long_lesson`, `scenario_fit_missing`.
  curatorFlags              Json     @default("[]") @map("curator_flags")
  taxonomyVersion           String   @map("taxonomy_version") @db.VarChar(32)
  promptId                  String   @map("prompt_id") @db.VarChar(64)
  promptVersion             String   @map("prompt_version") @db.VarChar(16)
  model                     String   @db.VarChar(64)
  /// Gemini-reported, summed over both attempts.
  inputTokens               Int?     @map("input_tokens")
  outputTokens              Int?     @map("output_tokens")
  latencyMs                 Int      @map("latency_ms")
  /// Whether F04's library retry was needed.
  schemaRetried             Boolean  @map("schema_retried")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lesson Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  errors LessonAnalysisError[]

  @@unique([lessonId, userId], map: "ux_lesson_analyses_lesson_user")
  @@index([userId, createdAt(sort: Desc)], map: "ix_lesson_analyses_user_created")
  @@map("lesson_analyses")
}

/// F11: one tagged error, quoted verbatim from the owner's own utterance and
/// stored beside its analysis for F12's ledger and F20's counts to read by
/// tag. `utteranceId` goes null (never the row) if the transcript is ever
/// replaced — the re-run that would cause that also replaces the analysis.
model LessonAnalysisError {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId  String   @map("analysis_id") @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// Order as returned, after discards.
  idx         Int      @db.SmallInt
  /// Verbatim, as the model returned it.
  quote       String
  /// A taxonomy tag, e.g. grammar:conditional-3.
  tag         String   @db.VarChar(64)
  correction  String
  explanation String
  /// One of minor, moderate, major.
  severity    String   @db.VarChar(8)
  utteranceId String?  @map("utterance_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  analysis  LessonAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  utterance LessonUtterance? @relation(fields: [utteranceId], references: [id], onDelete: SetNull)

  @@unique([analysisId, idx], map: "ux_analysis_errors_analysis_idx")
  @@index([userId, tag], map: "ix_analysis_errors_user_tag")
  @@map("lesson_analysis_errors")
}

/// The shared situation — every participant sees it. Created the moment the
/// lesson opens, before any model call, so `pending`, `failed` and
/// `no_scenario` are states of a row rather than the absence of one; F11
/// reads that status to be told explicitly when no scenario was in play.
///
/// Generated from no profile data of any participant, with the opener's own
/// key. `vocabularyDomain` is chosen server-side from the PRD's fifteen and
/// is the value F20 counts, never the model's echo of it.
model LessonScenario {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId         String   @unique(map: "ux_lesson_scenarios_lesson") @map("lesson_id") @db.Uuid
  /// One of pending, ready, failed, no_scenario.
  status           String   @default("pending") @db.VarChar(16)
  /// A 3-7 word headline. Null only on situations generated before 0006.
  title            String?  @db.VarChar(120)
  setting          String?
  premise          String?
  vocabularyDomain String?  @map("vocabulary_domain") @db.VarChar(48)
  /// `[{ label, relationship }]`, one per seat (`lessons.max_participants`).
  roles            Json?
  discussionHooks  Json?    @map("discussion_hooks")
  /// Bounded at 3 by a check constraint in the migration.
  rerollCount      Int      @default(0) @map("reroll_count") @db.SmallInt
  generatedBy      String?  @map("generated_by") @db.Uuid
  promptId         String?  @map("prompt_id") @db.VarChar(64)
  promptVersion    String?  @map("prompt_version") @db.VarChar(16)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  generator User?  @relation(fields: [generatedBy], references: [id], onDelete: SetNull)

  @@index([vocabularyDomain], map: "ix_lesson_scenarios_domain")
  @@map("lesson_scenarios")
}

/// One participant's private role card. `userId` is the only person who may
/// ever read this row — a product invariant, not a UI concern, so no later
/// feature should read another participant's card either.
///
/// The column behind `constraintText` is `constraint_text` because
/// CONSTRAINT is a reserved word in PostgreSQL; the API and client contracts
/// keep the PRD's `constraint`.
model LessonRoleCard {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId          String   @map("lesson_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// Drawn at random from the situation's unassigned labels; null while the
  /// situation is still pending.
  roleLabel         String?  @map("role_label") @db.VarChar(120)
  /// One of pending, ready, failed.
  status            String   @default("pending") @db.VarChar(16)
  background        String?
  objective         String?
  constraintText    String?  @map("constraint_text")
  /// One of formal, neutral, informal.
  register          String?  @db.VarChar(16)
  targetExpressions Json?    @map("target_expressions")
  promptId          String?  @map("prompt_id") @db.VarChar(64)
  promptVersion     String?  @map("prompt_version") @db.VarChar(16)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId], map: "ux_lesson_role_cards_lesson_user")
  @@map("lesson_role_cards")
}

/// F12: one row per user, created on first ingestion. Its only job besides
/// `updated_at` is to be the per-user lock: every ingestion takes
/// `SELECT … FOR UPDATE` on it first, so a lesson and an activity finishing
/// together never fold from a stale read.
model LearningProfile {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// The last applied source.
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_profiles")
}

/// F12: one applied source of profile evidence — a lesson's analysis, a
/// lesson's pronunciation result, or an activity attempt — keyed by
/// `(user, kind, source_key)`. The same `revision` again is skipped; a new
/// one replaces the row, and its evidence cascades away with it.
model ProfileSource {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  /// One of lesson_analysis, lesson_pronunciation, activity.
  kind             String   @db.VarChar(24)
  /// The lesson id, or the activity caller's idempotency key.
  sourceKey        String   @map("source_key") @db.Uuid
  /// The F11 or F10 row id, or the activity's revision.
  revision         String   @db.VarChar(64)
  /// Set for the lesson kinds (equals `source_key`).
  lessonId         String?  @map("lesson_id") @db.Uuid
  /// Set for `activity`. No foreign key: F16–F18's tables do not exist yet.
  activityId       String?  @map("activity_id") @db.Uuid
  /// The lesson's start (or opening), or the activity's completion — the fold order.
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(6)
  taxonomyVersion  String   @map("taxonomy_version") @db.VarChar(32)
  measurementCount Int      @default(0) @map("measurement_count") @db.SmallInt
  occurrenceCount  Int      @default(0) @map("occurrence_count") @db.SmallInt
  encounterCount   Int      @default(0) @map("encounter_count") @db.SmallInt
  /// Tags outside the taxonomy in force, rejected and logged for the curator.
  rejectedTags     Json     @default("[]") @map("rejected_tags")
  ingestedAt       DateTime @default(now()) @map("ingested_at") @db.Timestamptz(6)

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson?                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  measurements ProfileMeasurement[]
  occurrences  ErrorLedgerOccurrence[]
  encounters   ErrorLedgerEncounter[]

  @@unique([userId, kind, sourceKey], map: "ux_profile_sources_user_kind_key")
  @@index([userId, occurredAt(sort: Desc)], map: "ix_profile_sources_user_occurred")
  @@index([lessonId], map: "ix_profile_sources_lesson")
  @@map("profile_sources")
}

/// F12: one competency measurement from one source. `scoreAfter` (and the
/// sub-score columns) is the smoothed value after this row in the user's
/// ordered log, rewritten on every refold — what F20's chart plots.
model ProfileMeasurement {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  sourceId      String   @map("source_id") @db.Uuid
  /// One of grammar, vocabulary, fluency, interaction, comprehension, pronunciation.
  competency    String   @db.VarChar(16)
  /// lesson or activity.
  sourceKind    String   @map("source_kind") @db.VarChar(8)
  /// 0.35 for a lesson, 0.15 for an activity — from the kind, never the caller.
  weight        Float    @db.Real
  value         Float    @db.Real
  /// Raw sub-scores, pronunciation only; prosody may be null.
  accuracy      Float?   @db.Real
  prosody       Float?   @db.Real
  measuredAt    DateTime @map("measured_at") @db.Timestamptz(6)
  scoreAfter    Float    @map("score_after") @db.Real
  accuracyAfter Float?   @map("accuracy_after") @db.Real
  prosodyAfter  Float?   @map("prosody_after") @db.Real
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source ProfileSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, competency], map: "ux_profile_measurements_source_competency")
  @@index([userId, competency, measuredAt, createdAt], map: "ix_profile_measurements_user_competency_time")
  @@map("profile_measurements")
}

/// F12: the materialized current score of one competency, recomputed from
/// the measurement log on every ingestion that touches it. A competency with
/// no measurement has no row.
model ProfileCompetency {
  userId           String   @map("user_id") @db.Uuid
  competency       String   @db.VarChar(16)
  score            Float    @db.Real
  /// Before the last measurement; null for the first.
  previousScore    Float?   @map("previous_score") @db.Real
  measurementCount Int      @map("measurement_count")
  /// up, down or flat; set exactly when the count is at least 3.
  trend            String?  @db.VarChar(8)
  /// Current smoothed sub-scores, pronunciation only.
  accuracy         Float?   @db.Real
  prosody          Float?   @db.Real
  /// Measurements that reported prosody.
  prosodyCount     Int      @default(0) @map("prosody_count")
  lastMeasuredAt   DateTime @map("last_measured_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, competency])
  @@map("profile_competencies")
}

/// F12: one record per tag per user, aggregated from its occurrences.
/// `state` and `due_at` are the lifecycle's: Core writes `new` and
/// `practicing` and never a due date (the mastery lifecycle is Full scope).
model ErrorLedgerEntry {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tag             String    @db.VarChar(64)
  family          String    @db.VarChar(16)
  /// Label snapshot, refreshed on every write, so a retired tag keeps its name.
  label           String    @db.VarChar(120)
  occurrenceCount Int       @map("occurrence_count")
  firstSeenAt     DateTime  @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt      DateTime  @map("last_seen_at") @db.Timestamptz(6)
  /// One of new, practicing, mastered.
  state           String    @default("new") @db.VarChar(12)
  /// Null (not scheduled) throughout Core.
  dueAt           DateTime? @map("due_at") @db.Timestamptz(6)
  taxonomyVersion String    @map("taxonomy_version") @db.VarChar(32)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag], map: "ux_ledger_entries_user_tag")
  @@index([userId, lastSeenAt(sort: Desc)], map: "ix_ledger_entries_user_last_seen")
  @@map("error_ledger_entries")
}

/// F12: one sighting of a tag in one source — one per tagged analysis
/// error (with its quote), one per `phoneme:` tag per lesson (with F10's
/// failing-instance count and example words), one per activity entry.
model ErrorLedgerOccurrence {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  sourceId        String   @map("source_id") @db.Uuid
  tag             String   @db.VarChar(64)
  lessonId        String?  @map("lesson_id") @db.Uuid
  activityId      String?  @map("activity_id") @db.Uuid
  quote           String?
  correction      String?
  /// F11's minor, moderate or major.
  severity        String?  @db.VarChar(8)
  /// Up to 5 words (pronunciation).
  exampleWords    Json     @default("[]") @map("example_words")
  instances       Int      @default(1) @db.SmallInt
  /// F11's error row. No foreign key: F11 replaces its rows on re-run.
  analysisErrorId String?  @map("analysis_error_id") @db.Uuid
  utteranceId     String?  @map("utterance_id") @db.Uuid
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    ProfileSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  lesson    Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  utterance LessonUtterance? @relation(fields: [utteranceId], references: [id], onDelete: SetNull)

  @@index([userId, tag, occurredAt(sort: Desc)], map: "ix_ledger_occurrences_user_tag_time")
  @@index([sourceId], map: "ix_ledger_occurrences_source")
  @@map("error_ledger_occurrences")
}

/// F12: a correct answer on a tag in an activity. Incorrect ones are
/// occurrences. Recorded from day one so the mastery lifecycle (Full scope)
/// can compute streaks and distinct days from real evidence.
model ErrorLedgerEncounter {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sourceId   String   @map("source_id") @db.Uuid
  tag        String   @db.VarChar(64)
  activityId String   @map("activity_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source ProfileSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, tag], map: "ux_ledger_encounters_source_tag")
  @@index([userId, tag, occurredAt], map: "ix_ledger_encounters_user_tag_time")
  @@map("error_ledger_encounters")
}

/// F13: the content bank. One row per activity item of every type, curated
/// (imported from `assignment-content/`) or generated (F14), keyed by a slug
/// that is unique across both. Audio lives in MinIO; only its key, checksum
/// and size are stored. Questions carry their own `answer` and `explanation`
/// in one JSONB array, so an answer can never drift from its question.
///
/// Every type-, provenance- and media-dependent rule is also a CHECK
/// constraint in `0013_content_bank`, so a direct insert cannot create an
/// item F16 could never answer correctly. Prisma does not model CHECKs.
model ContentItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique(map: "content_item_slug_key") @db.VarChar(80)
  /// One of listening, reading, vocabulary, grammar, error_review.
  type            String   @db.VarChar(16)
  /// One of curated, generated.
  provenance      String   @db.VarChar(16)
  cefrLevel       String   @map("cefr_level") @db.VarChar(2)
  title           String   @db.VarChar(200)
  topic           String   @db.VarChar(80)
  /// Listening only, from a controlled vocabulary.
  accent          String?  @db.VarChar(24)
  /// Listening only, measured by decoding the audio at import.
  durationSeconds Int?     @map("duration_seconds")
  /// Derived from `body`, so F15 can estimate reading time without loading bodies.
  wordCount       Int?     @map("word_count")
  skills          String[]
  difficulty      Int      @db.SmallInt
  sourceName      String?  @map("source_name") @db.VarChar(200)
  sourceUrl       String?  @map("source_url") @db.VarChar(2048)
  body            String?
  /// Exactly five question objects, each with its format fields, `answer` and `explanation`.
  questions       Json
  targetTags      String[] @map("target_tags")
  /// `content/{type}/{slug}/{filename}`.
  mediaObjectKey  String?  @map("media_object_key") @db.VarChar(512)
  /// SHA-256 hex of the uploaded file; re-upload happens only when it changes.
  mediaChecksum   String?  @map("media_checksum") @db.Char(64)
  mediaBytes      Int?     @map("media_bytes")
  promptId        String?  @map("prompt_id") @db.VarChar(64)
  promptVersion   String?  @map("prompt_version") @db.VarChar(16)
  /// F14's difficulty-gate measurements, opaque to F13.
  gateMetrics     Json?    @map("gate_metrics")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  servings        ContentItemServing[]
  generationSlots ContentGenerationSlot[]
  planActivities  StudyPlanActivity[]

  @@index([type, cefrLevel], map: "ix_content_item_type_level")
  @@index([targetTags], map: "ix_content_item_target_tags", type: Gin)
  @@map("content_item")
}

/// F13: one row per item per activated plan (F15 calls `recordServed`). The
/// candidate query excludes what the requesting user was served in the last
/// 30 days, and `content:stats` reads usage from here.
model ContentItemServing {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  contentItemId String   @map("content_item_id") @db.Uuid
  servedAt      DateTime @default(now()) @map("served_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([userId, contentItemId, servedAt(sort: Desc)], map: "ix_content_item_serving_user_item_time")
  @@index([contentItemId], map: "ix_content_item_serving_item")
  @@map("content_item_serving")
}

// ---------------------------------------------------------------------------
// F14 AI content generation. CHECK constraints and the partial index on
// completed generated slots live only in 0014_content_generation, as with
// every earlier migration.
// ---------------------------------------------------------------------------

/// One generation batch per study plan, idempotent per (user, run key).
model ContentGenerationRun {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  runKey               String    @map("run_key") @db.VarChar(128)
  /// One of running, completed.
  status               String    @default("running") @db.VarChar(16)
  /// One of credential_missing, credential_rejected, quota_exhausted.
  abandonReason        String?   @map("abandon_reason") @db.VarChar(32)
  maxItems             Int       @map("max_items") @db.SmallInt
  rulesVersion         String    @map("rules_version") @db.VarChar(32)
  rulesFingerprint     String    @map("rules_fingerprint") @db.Char(64)
  frequencyListVersion String    @map("frequency_list_version") @db.VarChar(80)
  taxonomyVersion      String    @map("taxonomy_version") @db.VarChar(16)
  /// `[{ code, text }]`, for the plan to show.
  notes                Json      @default("[]")
  startedAt            DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz(6)

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots      ContentGenerationSlot[]
  studyPlans StudyPlan[]

  @@unique([userId, runKey], map: "ux_generation_runs_user_key")
  @@index([userId, startedAt(sort: Desc)], map: "ix_generation_runs_user_started")
  @@map("content_generation_runs")
}

/// One planned item of a run: its type and tags, then what became of it.
model ContentGenerationSlot {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId         String    @map("run_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  position      Int       @db.SmallInt
  /// One of reading, vocabulary, grammar, error_review.
  type          String    @db.VarChar(16)
  targetTags    String[]  @map("target_tags")
  /// `[{ tag, source, rank }]`: why each tag was chosen.
  tagSources    Json      @map("tag_sources")
  genre         String?   @db.VarChar(40)
  topicDomain   String    @map("topic_domain") @db.VarChar(40)
  exemplarIndex Int       @map("exemplar_index") @db.SmallInt
  /// One of pending, running, generated, fallback, dropped.
  status        String    @default("pending") @db.VarChar(16)
  reason        String?   @db.VarChar(32)
  /// The generated item, or the curated fallback.
  contentItemId String?   @map("content_item_id") @db.Uuid
  attemptCount  Int       @default(0) @map("attempt_count") @db.SmallInt
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)

  run         ContentGenerationRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem ContentItem?               @relation(fields: [contentItemId], references: [id], onDelete: NoAction)
  attempts    ContentGenerationAttempt[]

  @@unique([runId, position], map: "ux_generation_slots_run_position")
  @@index([runId, status], map: "ix_generation_slots_run_status")
  @@map("content_generation_slots")
}

/// One model call for a slot: the prompt stamp, the outcome and, when the gate ran, its metrics. Never item text.
model ContentGenerationAttempt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slotId        String   @map("slot_id") @db.Uuid
  attempt       Int      @db.SmallInt
  promptId      String   @map("prompt_id") @db.VarChar(64)
  promptVersion String   @map("prompt_version") @db.VarChar(16)
  outcome       String   @db.VarChar(24)
  failedChecks  String[] @default([]) @map("failed_checks")
  gateMetrics   Json?    @map("gate_metrics")
  errorDetail   String?  @map("error_detail") @db.VarChar(500)
  latencyMs     Int?     @map("latency_ms")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  slot ContentGenerationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, attempt], map: "ux_generation_attempts_slot_attempt")
  @@index([promptId, promptVersion, createdAt(sort: Desc)], map: "ix_generation_attempts_prompt_time")
  @@map("content_generation_attempts")
}

// ---------------------------------------------------------------------------
// F15 Study Plan Generation. CHECK constraints and the two partial unique
// indexes (exactly one active plan per user; at most one carried copy per
// activity) live only in 0015_study_plans, as with every earlier migration.
// ---------------------------------------------------------------------------

/// One plan per (user, lesson, origin). Composed by `PlanComposerService` from
/// F14's generated items and F13's bank on the owner's own Gemini key (or
/// deterministically, with no model call), then written by
/// `PlanActivationService` under a per-user advisory lock. Exactly one
/// `active` row per user (partial unique index, SQL only).
model StudyPlan {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  lessonId            String    @map("lesson_id") @db.Uuid
  /// One of lesson, recording_failed, analysis_blocked.
  origin              String    @db.VarChar(24)
  /// One of active, archived.
  status              String    @db.VarChar(16)
  /// The lesson's started_at, falling back to opened_at — denormalised for precedence (spec A1).
  precedenceAt        DateTime  @map("precedence_at") @db.Timestamptz(6)
  /// One of model, deterministic.
  composition         String    @db.VarChar(16)
  /// Set exactly when composition = deterministic. One of gemini_key_missing,
  /// gemini_key_rejected, gemini_quota_exhausted, model_call_failed,
  /// model_output_invalid, no_profile.
  deterministicReason String?   @map("deterministic_reason") @db.VarChar(32)
  /// Composed with no unmastered tags (first lesson, no profile yet).
  generalMaterial     Boolean   @default(false) @map("general_material")
  /// `[{ code, text }]`, server-built, in the fixed order (spec A15).
  notes               Json      @default("[]")
  /// Up to 3 tags, for the summary line.
  focusTags           String[]  @map("focus_tags")
  /// Set exactly when composition = model.
  promptId            String?   @map("prompt_id") @db.VarChar(64)
  promptVersion       String?   @map("prompt_version") @db.VarChar(16)
  model               String?   @db.VarChar(64)
  /// `{ offered, returned, accepted, rejected: { unknown, duplicate, off_target } }`.
  modelSelectionStats Json?     @map("model_selection_stats")
  generationRunId     String?   @map("generation_run_id") @db.Uuid
  rulesVersion        String    @map("rules_version") @db.VarChar(32)
  rulesFingerprint    String    @map("rules_fingerprint") @db.Char(64)
  taxonomyVersion     String    @map("taxonomy_version") @db.VarChar(16)
  /// Set when this plan was superseded before or at activation, pointing at the plan that won.
  supersededByPlanId  String?   @map("superseded_by_plan_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Null for a plan archived on arrival (superseded before ever being active).
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz(6)
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  generationRun ContentGenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  supersededBy  StudyPlan?            @relation("StudyPlanSupersedes", fields: [supersededByPlanId], references: [id], onDelete: SetNull)
  superseded    StudyPlan[]           @relation("StudyPlanSupersedes")
  activities    StudyPlanActivity[]
  requests      StudyPlanRequest[]

  @@unique([userId, lessonId, origin], map: "ux_study_plans_user_lesson_origin")
  @@index([userId, createdAt(sort: Desc)], map: "ix_study_plans_user_created")
  @@map("study_plans")
}

/// One activity in one plan's 7-day, 2–4-per-day grid. `contentItemId` is set
/// for the five bank kinds; the three task kinds (writing, speaking,
/// pronunciation) carry none — F17/F18 build the task when it opens.
/// `carriedFromActivityId` chains a carried-over activity back to the row it
/// continues in the previous plan, which is how the state contract resolves
/// an old id forward.
model StudyPlanActivity {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId                String    @map("plan_id") @db.Uuid
  /// Denormalised owner, for the state contract's ownership guard.
  userId                String    @map("user_id") @db.Uuid
  day                   Int       @db.SmallInt
  position              Int       @db.SmallInt
  /// One of listening, reading, vocabulary, grammar, error_review, writing, speaking, pronunciation.
  kind                  String    @db.VarChar(16)
  /// Set exactly for the five bank kinds.
  contentItemId         String?   @map("content_item_id") @db.Uuid
  /// Snapshot at placement time.
  title                 String    @db.VarChar(200)
  targetTags            String[]  @default([]) @map("target_tags")
  isReview              Boolean   @default(false) @map("is_review")
  /// Computed in code from item metadata or the rules file, never from the model.
  estimatedMinutes      Int       @map("estimated_minutes") @db.SmallInt
  rationale             String    @db.VarChar(240)
  /// One of model, template.
  rationaleSource       String    @map("rationale_source") @db.VarChar(16)
  /// One of model, guardrail, carry_over, task — what code placed it, for the curator.
  placement             String    @db.VarChar(16)
  carriedFromActivityId String?   @map("carried_from_activity_id") @db.Uuid
  /// One of pending, in_progress, completed, skipped.
  state                 String    @default("pending") @db.VarChar(16)
  startedAt             DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(6)
  skippedAt             DateTime? @map("skipped_at") @db.Timestamptz(6)
  skipReason            String?   @map("skip_reason") @db.VarChar(200)
  /// The attempt id that completed it; a repeat is a no-op.
  completionKey         String?   @map("completion_key") @db.Uuid
  scoreCorrect          Int?      @map("score_correct") @db.SmallInt
  scoreTotal            Int?      @map("score_total") @db.SmallInt
  timeSpentSeconds      Int?      @map("time_spent_seconds")
  /// One of too_easy, just_right, too_hard.
  difficultyRating      String?   @map("difficulty_rating") @db.VarChar(12)
  notUseful             Boolean   @default(false) @map("not_useful")
  ratedAt               DateTime? @map("rated_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan        StudyPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem ContentItem?        @relation(fields: [contentItemId], references: [id], onDelete: NoAction)
  carriedFrom StudyPlanActivity?  @relation("StudyPlanActivityCarry", fields: [carriedFromActivityId], references: [id], onDelete: SetNull)
  carriedTo   StudyPlanActivity[] @relation("StudyPlanActivityCarry")
  writingTask WritingTask?
  speakingTask     SpeakingTask?    @relation("SpeakingTaskRoot")
  speakingAttempts SpeakingAttempt[] @relation("SpeakingAttemptActivity")

  @@unique([planId, day, position], map: "ux_plan_activities_plan_slot")
  @@index([userId, completedAt(sort: Desc)], map: "ix_plan_activities_user_completed")
  @@map("study_plan_activities")
}

/// F18: a speaking plan activity's task, chosen once from the versioned
/// corpus and kept for its whole carry-over lineage. `rootActivityId` is the
/// oldest id in that lineage, so a carried activity resolves to the same row.
model SpeakingTask {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  rootActivityId    String   @unique(map: "ux_speaking_tasks_root_activity") @map("root_activity_id") @db.Uuid
  /// One of read_aloud, open_response.
  shape             String   @db.VarChar(16)
  corpusEntryId     String   @map("corpus_entry_id") @db.VarChar(64)
  corpusVersion     String   @map("corpus_version") @db.VarChar(16)
  corpusFingerprint String   @map("corpus_fingerprint") @db.Char(64)
  /// Set exactly for read_aloud — a snapshot of the passage.
  referenceText     String?  @map("reference_text")
  /// Set exactly for open_response.
  promptText        String?  @map("prompt_text")
  hint              String?  @db.VarChar(200)
  targetTags        String[] @default([]) @map("target_tags")
  focusTags         String[] @default([]) @map("focus_tags")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rootActivity StudyPlanActivity @relation("SpeakingTaskRoot", fields: [rootActivityId], references: [id], onDelete: Cascade)
  attempts     SpeakingAttempt[]

  @@index([userId, corpusEntryId, createdAt(sort: Desc)], map: "ix_speaking_tasks_user_entry")
  @@map("speaking_tasks")
}

/// F18: one uploaded recording against a speaking task. Every attempt is
/// retained; only `scored` ones count toward the limit of 3 and carry an
/// `ordinal`. A per-task row lock plus the two partial unique indexes below
/// enforce "at most 3 scored, one in flight" across devices.
model SpeakingAttempt {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId              String    @map("task_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  activityId          String    @map("activity_id") @db.Uuid
  clientAttemptId     String    @map("client_attempt_id") @db.Uuid
  /// One of scoring, scored, discarded, failed.
  state               String    @db.VarChar(16)
  /// 1-3, set exactly when scored.
  ordinal             Int?      @db.SmallInt
  /// Null exactly when discarded.
  audioObjectKey      String?   @map("audio_object_key") @db.VarChar(255)
  audioBytes          Int       @map("audio_bytes")
  durationMs          Int       @map("duration_ms")
  /// Lease start while scoring.
  scoringStartedAt    DateTime? @map("scoring_started_at") @db.Timestamptz(6)
  scoredAt            DateTime? @map("scored_at") @db.Timestamptz(6)
  /// Set exactly when failed or discarded. A SpeakingFailureCode value.
  failureCode         String?   @map("failure_code") @db.VarChar(32)
  failureReason       String?   @map("failure_reason") @db.VarChar(200)
  rescoreCount        Int       @default(0) @map("rescore_count") @db.SmallInt
  pronunciation       Float?    @db.Real
  accuracy            Float?    @db.Real
  fluency             Float?    @db.Real
  /// Null where the assessment locale does not report it.
  prosody             Float?    @db.Real
  completeness        Float?    @db.Real
  recognizedWordCount Int?      @map("recognized_word_count") @db.SmallInt
  /// The open response's own transcript, when one was made.
  transcriptText      String?   @map("transcript_text")
  /// Display tokens with accuracy, error types, recording offsets and phonemes.
  words               Json?
  failingPhonemes     Json?     @map("failing_phonemes")
  /// For the curator: per-segment reference, scores and latency.
  segments            Json?
  locale              String?   @db.VarChar(16)
  /// Sum over every provider call this attempt made.
  latencyMs           Int?      @map("latency_ms")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  task     SpeakingTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity StudyPlanActivity @relation("SpeakingAttemptActivity", fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, clientAttemptId], map: "ux_speaking_attempts_client")
  @@index([taskId, createdAt], map: "ix_speaking_attempts_task_created")
  @@map("speaking_attempts")
}

/// The fallback (F07's `StudyPlanFallbackPort`) and interim-plan (analysis
/// blocked on a missing Gemini key) build queue `PlanRequestJob` polls — the
/// two origins that run outside the `plan_generation` pipeline stage.
model StudyPlanRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  lessonId      String    @map("lesson_id") @db.Uuid
  /// One of recording_failed, analysis_blocked.
  origin        String    @db.VarChar(24)
  /// One of pending, running, retrying, completed, superseded, failed.
  status        String    @default("pending") @db.VarChar(16)
  attempts      Int       @default(0) @db.SmallInt
  /// Lease start while running.
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)
  /// Set exactly while retrying.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  progressDone  Int?      @map("progress_done") @db.SmallInt
  progressTotal Int?      @map("progress_total") @db.SmallInt
  /// Set exactly when failed.
  failureReason String?   @map("failure_reason") @db.VarChar(200)
  /// Set when completed.
  planId        String?   @map("plan_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Set in completed, superseded and failed.
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  plan   StudyPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([userId, lessonId, origin], map: "ux_plan_requests_user_lesson_origin")
  @@index([status, nextAttemptAt], map: "ix_plan_requests_claim")
  @@map("study_plan_requests")
}

/// The task composed when a plan's writing activity is first opened (F17),
/// and its one server-side draft. Looked up by every id in the activity's
/// carry-over lineage, so a carried-over copy reopens the same task.
model WritingTask {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  activityId       String    @unique(map: "ux_writing_tasks_activity") @map("activity_id") @db.Uuid
  heading          String    @db.VarChar(80)
  statement        String
  statementWords   Int       @map("statement_words") @db.SmallInt
  targetTags       String[]  @default([]) @map("target_tags")
  scenarioId       String    @map("scenario_id") @db.VarChar(48)
  rulesVersion     String    @map("rules_version") @db.VarChar(32)
  rulesFingerprint String    @map("rules_fingerprint") @db.Char(64)
  taxonomyVersion  String    @map("taxonomy_version") @db.VarChar(16)
  /// One of draft, correcting, uncorrected, correction_failed, corrected.
  status           String    @default("draft") @db.VarChar(24)
  draftText        String    @default("") @map("draft_text")
  draftRevision    Int       @default(0) @map("draft_revision")
  /// Null exactly at revision 0.
  draftSavedAt     DateTime? @map("draft_saved_at") @db.Timestamptz(6)
  activeSeconds    Int       @default(0) @map("active_seconds")
  /// The latest submission.
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz(6)
  /// Set exactly when corrected.
  correctedAt      DateTime? @map("corrected_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity    StudyPlanActivity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  corrections WritingCorrection[]

  @@index([userId, createdAt(sort: Desc)], map: "ix_writing_tasks_user_created")
  @@map("writing_tasks")
}

/// One row per correction request: a submission or a resubmission (F17). The
/// daily limit counts these rows in a rolling 24-hour window, and the
/// curator reads their prompt stamp and, for invalid output, the raw
/// response.
model WritingCorrection {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId               String    @map("task_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  submissionId         String    @map("submission_id") @db.Uuid
  draftRevision        Int       @map("draft_revision")
  submittedText        String    @map("submitted_text")
  wordCount            Int       @map("word_count") @db.SmallInt
  /// One of running, succeeded, failed.
  status               String    @default("running") @db.VarChar(16)
  attempts             Int       @default(0) @db.SmallInt
  attemptOutcomes      String[]  @default([]) @map("attempt_outcomes")
  requestedAt          DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  /// Lease start while running.
  claimedAt            DateTime? @map("claimed_at") @db.Timestamptz(6)
  /// Set exactly when not running.
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz(6)
  /// One of request_failed, invalid_output, gemini_key. Set exactly when failed.
  failureCode          String?   @map("failure_code") @db.VarChar(24)
  failureDetail        String?   @map("failure_detail") @db.VarChar(500)
  /// Only for invalid_output.
  rawResponse          String?   @map("raw_response")
  promptId             String?   @map("prompt_id") @db.VarChar(64)
  promptVersion        String?   @map("prompt_version") @db.VarChar(16)
  model                String?   @db.VarChar(64)
  inputTokens          Int?      @map("input_tokens")
  outputTokens         Int?      @map("output_tokens")
  latencyMs            Int?      @map("latency_ms")
  overallComment       String?   @map("overall_comment")
  scoreGrammar         Int?      @map("score_grammar") @db.SmallInt
  scoreVocabulary      Int?      @map("score_vocabulary") @db.SmallInt
  scoreCoherence       Int?      @map("score_coherence") @db.SmallInt
  scoreTaskAchievement Int?      @map("score_task_achievement") @db.SmallInt
  revisedText          String?   @map("revised_text")
  /// Unlocated, overlong or duplicate errors.
  discardedErrorCount  Int?      @map("discarded_error_count") @db.SmallInt
  /// `{ "<tag>": <prior occurrences> }`.
  ledgerPriorCounts    Json?     @map("ledger_prior_counts")
  /// From F12's ingestion result. Nullable at the database level (unset until succeeded); Prisma reads a NULL array as empty.
  rejectedTags         String[] @map("rejected_tags")

  task   WritingTask                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  errors WritingCorrectionError[]

  @@unique([taskId, submissionId], map: "ux_writing_corrections_submission")
  @@index([userId, requestedAt(sort: Desc)], map: "ix_writing_corrections_user_requested")
  @@map("writing_corrections")
}

/// One accepted error on a writing correction (F17), located verbatim in the
/// submitted text: the quote is the text's own span.
model WritingCorrectionError {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correctionId String @map("correction_id") @db.Uuid
  idx          Int    @db.SmallInt
  quote        String @db.VarChar(500)
  tag          String @db.VarChar(64)
  correction   String @db.VarChar(500)
  explanation  String
  startOffset  Int    @map("start_offset")
  endOffset    Int    @map("end_offset")

  correctionRow WritingCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)

  @@unique([correctionId, idx], map: "ux_writing_errors_correction_idx")
  @@map("writing_correction_errors")
}
