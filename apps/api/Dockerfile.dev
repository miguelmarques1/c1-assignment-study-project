# Development image for the NestJS API. It intentionally does not run a dev
# server: the container starts idle and the developer launches the server with
#   docker compose exec api pnpm dev
FROM node:22-bookworm-slim

# openssl is required by Prisma's query engine on debian-slim images.
# curl and wget back the dependency probes and container healthchecks.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssl \
        ca-certificates \
        curl \
        wget \
        procps \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NODE_ENV=development

WORKDIR /workspace

EXPOSE 3001

CMD ["sleep", "infinity"]
