Thumbs.db

.idea/
*.swp

# Listening audio and other imported media are uploaded to object storage by the
# importer; only the meta.json files belong in version control.
assignment-content/**/*.mp3
assignment-content/**/*.m4a
assignment-content/**/*.wav
assignment-content/**/*.ogg

*.tsbuildinfo
next-env.d.ts
.pnpm-store/

# Dart tooling cache for packages/design-tokens' pub side; apps/mobile carries
# its own Flutter-generated .gitignore for everything else Dart/Flutter.
.dart_tool/

# design-tokens is a pub *library*, not an app — Dart convention is libraries
# don't commit their lockfile (apps/mobile's pubspec.lock is committed).
packages/design-tokens/pubspec.lock

# Playwright's per-run failure artifacts and HTML report — the committed
# baselines live in apps/web/e2e/__screenshots__, which this does not touch.
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
