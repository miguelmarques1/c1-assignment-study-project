{
  "name": "@english-quest/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of styling values for English Quest, generating CSS custom properties, a typed TypeScript module and a Flutter theme",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./css": "./generated/tokens.css"
  },
  "files": [
    "dist",
    "generated",
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "tokens:build": "tsx src/build.ts && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
