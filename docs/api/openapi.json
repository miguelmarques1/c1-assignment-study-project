{
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "description": "Issues a session cookie. A wrong password and an unknown email return an identical body and comparable response time, so account existence cannot be probed.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in. Sets the `eq_session` cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/PublicUser"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "AUTH: payload failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "AUTH001: wrong credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "AUTH002: locked out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/token": {
      "post": {
        "description": "Issues the same session as `/auth/login` — same credential check, same lockout — but returns the opaque token in the response body instead of a cookie, and sets no cookie at all. For clients with no cookie jar (the native mobile app). The web client never calls this route.",
        "operationId": "AuthController_issueToken",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in. Token, its expiry and the user are returned in the body.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SessionToken"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "AUTH: payload failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "AUTH001: wrong credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "AUTH002: locked out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Sign in (token transport)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Destroys the session server-side and clears the cookie. The token stops working immediately.",
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Signed out."
          },
          "401": {
            "description": "AUTH003: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "description": "Returns the signed-in user and the session expiry, which slides on every authenticated request.",
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The current user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CurrentUser"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "AUTH003: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Current user",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/password": {
      "post": {
        "description": "Replaces the password and evicts every other session for the account, keeping the caller signed in.",
        "operationId": "AuthController_changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed; other sessions revoked."
          },
          "400": {
            "description": "AUTH004: wrong current password, or invalid payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "AUTH003: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Change password",
        "tags": [
          "auth"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Probes PostgreSQL, Redis, MinIO and LiveKit independently. Unauthenticated, because it must be reachable before a session exists. Answers 503 when any probe fails, but still returns the full report so the caller learns which one.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every dependency is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/HealthReport"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "HEALTH001: at least one dependency is down; the body still lists every probe.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/HealthReport"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Dependency health",
        "tags": [
          "health"
        ]
      }
    },
    "/credentials": {
      "get": {
        "description": "Returns one entry per provider, always both, so the client never special-cases an absent credential. Key material is never included — only a mask of the last four characters.",
        "operationId": "CredentialsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The caller’s credentials, masked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MaskedCredentialList"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "List credentials",
        "tags": [
          "credentials"
        ]
      }
    },
    "/credentials/{provider}": {
      "put": {
        "description": "Validates against the provider before storing. A rejected key is discarded and any previously stored credential is left untouched; an unreachable provider stores the key as unverified for the daily job to retry.",
        "operationId": "CredentialsController_save",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "gemini",
                "azure_speech"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveCredentialRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored. Status is valid, or unverified when the provider could not be reached.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MaskedCredential"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "CRED001: the provider rejected the key; nothing was stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Save or replace a credential",
        "tags": [
          "credentials"
        ]
      },
      "delete": {
        "description": "Removes the stored key. The provider returns to missing, which immediately blocks the stages that depend on it without affecting any other participant.",
        "operationId": "CredentialsController_remove",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "gemini",
                "azure_speech"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          }
        },
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Delete a credential",
        "tags": [
          "credentials"
        ]
      }
    },
    "/credentials/{provider}/revalidate": {
      "post": {
        "description": "Re-probes the stored credential and persists the refreshed status.",
        "operationId": "CredentialsController_revalidate",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "gemini",
                "azure_speech"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Re-probed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MaskedCredential"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "CRED002: no credential stored for that provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "CRED003: the stored credential could not be decrypted; it is now invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Re-validate on demand",
        "tags": [
          "credentials"
        ]
      }
    },
    "/classroom/token": {
      "post": {
        "description": "Opens the room's lesson if none is open, checks live occupancy against the configured cap before anything is issued, and returns a signed LiveKit token valid for 6 hours.",
        "operationId": "ClassroomController_requestToken",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Token issued.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ClassroomToken"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "AUTH003: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "CLASS001: the room is at the configured cap.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "CLASS002: LiveKit could not be reached. No lesson row is committed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Request a classroom token",
        "tags": [
          "classroom"
        ]
      }
    },
    "/classroom/session": {
      "get": {
        "description": "Answers only \"is a lesson open right now\" — null when nothing is open.",
        "operationId": "ClassroomController_session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The open session, or null.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ClassroomSession"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "AUTH003: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Read the open classroom session",
        "tags": [
          "classroom"
        ]
      }
    },
    "/classroom/{lessonId}/end": {
      "post": {
        "description": "Any connected participant may end the lesson for everyone.",
        "operationId": "ClassroomController_end",
        "parameters": [
          {
            "name": "lessonId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ended.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ClassroomEndResult"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "VAL001: lessonId is not a valid UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "AUTH003: no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "CLASS004: the caller is not a participant of that lesson.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "CLASS003: the lesson is already in a terminal state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "End the lesson",
        "tags": [
          "classroom"
        ]
      }
    },
    "/classroom/livekit-webhook": {
      "post": {
        "description": "Receives participant_joined, participant_left and room_finished. Every other event type is acknowledged and ignored. Authenticated by the Authorization header signature over a SHA-256 checksum of the raw body, verified with WebhookReceiver — never by session.",
        "operationId": "ClassroomWebhookController_handle",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Acknowledged."
          },
          "401": {
            "description": "AUTH003: missing, malformed or invalid signature; no state is changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "LiveKit lifecycle webhook",
        "tags": [
          "classroom"
        ]
      }
    }
  },
  "info": {
    "title": "English Quest API",
    "description": "API for the English Quest study platform.\n\nEvery successful response nests its payload under `data`; every failure nests\nunder `error` with a stable `code`. Clients should switch on the code, never\non the message.\n\nAuthentication has two transports carrying the same opaque token. Browsers use a\n`eq_session` cookie, issued by `POST /auth/login` — HttpOnly and signed, so it\ncannot be read or forged from JavaScript. Clients with no cookie jar (the native\nmobile app) use `POST /auth/token` instead, which returns the token in the body\nand sets no cookie, and carry it as `Authorization: Bearer <token>` on every\nlater request. In Postman or Insomnia, enable the cookie jar and log in through\n`/auth/login`, or call `/auth/token` and set the bearer token on the collection.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Session lifecycle and credentials"
    },
    {
      "name": "health",
      "description": "Infrastructure dependency probes"
    },
    {
      "name": "classroom",
      "description": "The persistent live-lesson room"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "eq_session"
      },
      "sessionBearer": {
        "scheme": "bearer",
        "bearerFormat": "opaque token from POST /auth/token",
        "type": "http"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "PublicUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName"
        ],
        "additionalProperties": false
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "sessionExpiresAt"
        ],
        "additionalProperties": false
      },
      "SessionToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "displayName"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "token",
          "expiresAt",
          "user"
        ],
        "additionalProperties": false
      },
      "HealthReport": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
